set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

set(CMAKE_C_COMPILER x86_64-w64-mingw32-gcc)
set(CMAKE_CXX_COMPILER x86_64-w64-mingw32-g++)
set(CMAKE_RC_COMPILER x86_64-w64-mingw32-windres)

if(NOT DEFINED VEYRA_MINGW_ROOT)
 execute_process(
  COMMAND "${CMAKE_CXX_COMPILER}" -print-sysroot
  OUTPUT_VARIABLE _veyra_mingw_sysroot
  OUTPUT_STRIP_TRAILING_WHITESPACE
 )
 set(VEYRA_MINGW_ROOT "${_veyra_mingw_sysroot}/mingw")
endif()

set(CMAKE_FIND_ROOT_PATH "${VEYRA_MINGW_ROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

if(NOT DEFINED CMAKE_CROSSCOMPILING_EMULATOR)
 find_program(VEYRA_WINE_EXECUTABLE wine)
 if(VEYRA_WINE_EXECUTABLE)
  set(CMAKE_CROSSCOMPILING_EMULATOR
   "${CMAKE_COMMAND}" -E env "WINEPATH=${VEYRA_MINGW_ROOT}/bin"
   "${VEYRA_WINE_EXECUTABLE}")
 endif()
endif()
