if(VEYRA_WITH_CODECS)
 add_library(veyra_codecs STATIC src/media/codec/image_codecs.cpp src/media/codec/image_codecs_stb.cpp)
 if(VEYRA_WITH_SVG)
  target_sources(veyra_codecs PRIVATE src/media/codec/image_codecs_svg.cpp)
 endif()
 target_include_directories(veyra_codecs PUBLIC $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>)
 target_include_directories(veyra_codecs PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/third_party/stb)
 target_include_directories(veyra_codecs PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/third_party/nanosvg)
 target_compile_features(veyra_codecs PUBLIC cxx_std_23)

 if(VEYRA_WITH_SVG)
  target_compile_definitions(veyra_codecs PRIVATE VEYRA_WITH_SVG=1)
 endif()

 if(VEYRA_WITH_WEBP)
  find_package(PkgConfig QUIET)
  if(PkgConfig_FOUND)
   pkg_check_modules(WEBP QUIET IMPORTED_TARGET libwebp libwebpdemux libwebpmux)
  endif()
  if(NOT WEBP_FOUND)
   set(WEBP_BUILD_ANIM_UTILS OFF CACHE BOOL "" FORCE)
   set(WEBP_BUILD_CWEBP OFF CACHE BOOL "" FORCE)
   set(WEBP_BUILD_DWEBP OFF CACHE BOOL "" FORCE)
   set(WEBP_BUILD_GIF2WEBP OFF CACHE BOOL "" FORCE)
   set(WEBP_BUILD_IMG2WEBP OFF CACHE BOOL "" FORCE)
   set(WEBP_BUILD_VWEBP OFF CACHE BOOL "" FORCE)
   set(WEBP_BUILD_WEBPINFO OFF CACHE BOOL "" FORCE)
   set(WEBP_BUILD_WEBPMUX OFF CACHE BOOL "" FORCE)
   set(WEBP_BUILD_EXTRAS OFF CACHE BOOL "" FORCE)
   include(FetchContent)
   FetchContent_Declare(
    libwebp
    URL ${VEYRA_LIBWEBP_URL}
    URL_HASH SHA256=${VEYRA_LIBWEBP_SHA256}
   )
   FetchContent_MakeAvailable(libwebp)
   target_compile_definitions(veyra_codecs PRIVATE VEYRA_WITH_WEBP=1)
   target_link_libraries(veyra_codecs PRIVATE webp webpdemux libwebpmux)
   set(VEYRA_WEBP_LINK_LIBS webp webpdemux libwebpmux)
   set(WEBP_FOUND TRUE)
  else()
   target_compile_definitions(veyra_codecs PRIVATE VEYRA_WITH_WEBP=1)
   target_link_libraries(veyra_codecs PRIVATE PkgConfig::WEBP)
   set(VEYRA_WEBP_LINK_LIBS PkgConfig::WEBP)
  endif()
 endif()
 if(WEBP_FOUND)
  target_sources(veyra_codecs PRIVATE src/media/codec/image_codecs_webp.cpp)
 endif()

 if(VEYRA_WITH_AVIF)
  find_package(PkgConfig QUIET)
  if(PkgConfig_FOUND)
   pkg_check_modules(AVIF QUIET IMPORTED_TARGET libavif)
  endif()
  if(NOT AVIF_FOUND)
   unset(VEYRA_AVIF_ASSEMBLER CACHE)
   find_program(VEYRA_AVIF_ASSEMBLER NAMES nasm yasm)
   if(NOT VEYRA_AVIF_ASSEMBLER AND NOT DEFINED AOM_TARGET_CPU)
    set(AOM_TARGET_CPU generic CACHE STRING "aom target without SIMD (no assembler found)" FORCE)
    set(VEYRA_AOM_TARGET_CPU_AUTO TRUE CACHE INTERNAL "")
   elseif(VEYRA_AVIF_ASSEMBLER AND VEYRA_AOM_TARGET_CPU_AUTO)
    unset(AOM_TARGET_CPU CACHE)
    unset(VEYRA_AOM_TARGET_CPU_AUTO CACHE)
   endif()
   set(AVIF_CODEC_AOM LOCAL CACHE STRING "" FORCE)
   set(AVIF_CODEC_DAV1D OFF CACHE STRING "" FORCE)
   set(AVIF_CODEC_LIBGAV1 OFF CACHE STRING "" FORCE)
   set(AVIF_CODEC_RAV1E OFF CACHE STRING "" FORCE)
   set(AVIF_CODEC_SVT OFF CACHE STRING "" FORCE)
   set(AVIF_CODEC_AVM OFF CACHE STRING "" FORCE)
   set(AVIF_LIBYUV OFF CACHE STRING "" FORCE)
   set(AVIF_LIBSHARPYUV OFF CACHE STRING "" FORCE)
   set(AVIF_ZLIBPNG OFF CACHE STRING "" FORCE)
   set(AVIF_JPEG OFF CACHE STRING "" FORCE)
   set(AVIF_BUILD_APPS OFF CACHE BOOL "" FORCE)
   set(AVIF_BUILD_TESTS OFF CACHE BOOL "" FORCE)
   set(AVIF_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
   include(FetchContent)
   FetchContent_Declare(
    libavif
    URL ${VEYRA_LIBAVIF_URL}
    URL_HASH SHA256=${VEYRA_LIBAVIF_SHA256}
   )
   FetchContent_MakeAvailable(libavif)
   target_compile_definitions(veyra_codecs PRIVATE VEYRA_WITH_AVIF=1)
   target_link_libraries(veyra_codecs PRIVATE avif)
   target_include_directories(veyra_codecs PRIVATE ${libavif_SOURCE_DIR}/include)
   set(VEYRA_AVIF_LINK_LIBS avif)
   set(AVIF_FOUND TRUE)
  else()
   target_compile_definitions(veyra_codecs PRIVATE VEYRA_WITH_AVIF=1)
   target_link_libraries(veyra_codecs PRIVATE PkgConfig::AVIF)
   set(VEYRA_AVIF_LINK_LIBS PkgConfig::AVIF)
  endif()
 endif()
 if(AVIF_FOUND)
  target_sources(veyra_codecs PRIVATE src/media/codec/image_codecs_avif.cpp)
 endif()


 set(_codecs_test_defs "")
 if(VEYRA_WITH_WEBP)
  list(APPEND _codecs_test_defs VEYRA_WITH_WEBP=1)
 endif()
 if(VEYRA_WITH_SVG)
  list(APPEND _codecs_test_defs VEYRA_WITH_SVG=1)
 endif()
 if(VEYRA_WITH_AVIF)
  list(APPEND _codecs_test_defs VEYRA_WITH_AVIF=1)
 endif()
 veyra_add_test(NAME image_codecs_behavior TARGET veyra_image_codecs_test SOURCES tests/image_codecs_test.cpp LIBS veyra_codecs INCLUDES third_party/stb DEFINES ${_codecs_test_defs})
 unset(_codecs_test_defs)

 if(VEYRA_WITH_SVG)
  veyra_add_test(NAME svg_decode_behavior TARGET veyra_svg_decode_test SOURCES tests/svg_decode_test.cpp LIBS veyra_codecs)
 endif()

 if(WEBP_FOUND)
  veyra_add_test(NAME webp_decode_behavior TARGET veyra_webp_decode_test SOURCES tests/webp_decode_test.cpp LIBS veyra_codecs ${VEYRA_WEBP_LINK_LIBS})
 endif()

 if(AVIF_FOUND)
  veyra_add_test(NAME avif_decode_behavior TARGET veyra_avif_decode_test SOURCES tests/avif_decode_test.cpp LIBS veyra_codecs ${VEYRA_AVIF_LINK_LIBS})
 endif()
endif()
