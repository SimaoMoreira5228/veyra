function(veyra_add_test)
 set(_flags NO_TEST NO_BUILD WILL_FAIL BENCH_DEFINES)
 set(_single NAME TARGET SKIP_RETURN_CODE)
 set(_multi SOURCES LIBS DEFINES INCLUDES ARGS ENVIRONMENT)
 cmake_parse_arguments(VAT "${_flags}" "${_single}" "${_multi}" ${ARGN})
 if(NOT VAT_NO_BUILD)
  add_executable(${VAT_TARGET} ${VAT_SOURCES})
  if(VAT_LIBS)
   target_link_libraries(${VAT_TARGET} PRIVATE ${VAT_LIBS})
  endif()
  if(VAT_INCLUDES)
   target_include_directories(${VAT_TARGET} PRIVATE ${VAT_INCLUDES})
  endif()
  if(VAT_DEFINES)
   target_compile_definitions(${VAT_TARGET} PRIVATE ${VAT_DEFINES})
  endif()
  if(VAT_BENCH_DEFINES)
   target_compile_definitions(${VAT_TARGET} PRIVATE
    "VEYRA_BUILD_PLATFORM=\"${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}\""
    "VEYRA_BUILD_COMPILER=\"${CMAKE_CXX_COMPILER_ID}-${CMAKE_CXX_COMPILER_VERSION}\""
    "VEYRA_BUILD_CONFIG=\"${veyra_build_config}\"")
  endif()
 endif()
 if(NOT VAT_NO_TEST)
  add_test(NAME ${VAT_NAME} COMMAND ${VAT_TARGET} ${VAT_ARGS})
  if(VAT_ENVIRONMENT)
   set_tests_properties(${VAT_NAME} PROPERTIES ENVIRONMENT "${VAT_ENVIRONMENT}")
  endif()
  if(VAT_WILL_FAIL)
   set_tests_properties(${VAT_NAME} PROPERTIES WILL_FAIL TRUE)
  endif()
  if(VAT_SKIP_RETURN_CODE)
   set_tests_properties(${VAT_NAME} PROPERTIES SKIP_RETURN_CODE ${VAT_SKIP_RETURN_CODE})
  endif()
 endif()
endfunction()
